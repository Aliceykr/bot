# ESP32-S3 project defaults (merged single file)

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash: 16MB QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# PSRAM: 8MB Octal 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Place WiFi/LwIP buffers in PSRAM to free internal DRAM for BT coexistence
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU 240MHz
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS 1kHz tick
CONFIG_FREERTOS_HZ=1000

# Compiler optimization size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# mbedTLS in PSRAM to avoid DRAM fragmentation
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# LWIP
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# WiFi: shrink static DMA buffers, use dynamic alloc from PSRAM
# Default 10 * 1.6KB static RX = 16KB contiguous DRAM+DMA, not enough with BLE
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4

# Bluetooth LE (NimBLE, ~40KB lighter than Bluedroid)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# Peripheral role only (we only advertise + accept connections)
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Trim optional features to reduce RAM
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP32-Bot"

# BT/WiFi coexistence (required when BLE and WiFi both active)
CONFIG_SW_COEXIST_ENABLE=y

# LVGL large font support
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# FATFS: 开启长文件名 + 中文 GBK 代码页
# 不开的话，中文文件名会被转成 Windows 8.3 短名（如 "M50000~1.MP3"）
# - LFN_HEAP：长文件名缓冲放堆，比 STACK 省 DRAM
# - LFN_MAX_CHAR_SIZE=3：每个 UCS-2 字符最多 3 字节 UTF-8，兼容中文
# - CODEPAGE_936：Simplified Chinese，SD 卡上中文名按 GBK 编码存
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_CODEPAGE=936

# ESP-SR offline voice recognition models
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_NSN_NSNET2=y
CONFIG_SR_VADN_VADNET1_SMALL=y
