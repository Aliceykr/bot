CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Flash mode: QIO is ~2x faster than DIO for code fetch
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# SPIRAM_FETCH_INSTRUCTIONS disabled: code in PSRAM hurts CPU-heavy tasks (Peanut/Walnut).
# SPIRAM_RODATA enabled: read-only constants in PSRAM saves ~80KB internal DRAM for
# WiFi/mbedtls, no measurable impact on emulator hot loops (they use internal IRAM).
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# CPU at max 240 MHz
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_FREERTOS_HZ=1000

# Compiler optimization: size (-Os), saves ~10-20% code size to fit OTA partitions
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Let mbedtls allocate from PSRAM pool, avoiding internal DRAM fragmentation
# that causes HTTPS handshake to fail on WiFi-heavy workloads.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# Bluetooth LE (Bluedroid BLE only)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
